
{
  "entities": {
    "Tournament": {
      "title": "Tournament",
      "description": "Details of a competitive gaming tournament.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "upcoming", "completed"] },
        "game": { "type": "string" },
        "gameType": { "type": "string", "enum": ["BGMI", "Free Fire", "Ludo King", "Other"] },
        "prizePool": { "type": "string" },
        "entryFee": { "type": "number" },
        "startDate": { "type": "string", "format": "date-time" },
        "banner": { "type": "string" },
        "roomCredentials": {
          "type": "object",
          "properties": {
            "roomId": { "type": "string" },
            "roomPassword": { "type": "string" }
          }
        }
      },
      "required": ["name", "status", "game", "prizePool", "entryFee", "startDate"]
    },
    "Registration": {
      "title": "Tournament Registration",
      "description": "Record of a user joining a tournament.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "tournamentId": { "type": "string" },
        "gameId": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date-time" }
      }
    },
    "SupportMessage": {
      "title": "Support Message",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "message": { "type": "string" },
        "aiResponse": { "type": "string" },
        "isFlagged": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "Match": {
      "title": "Match",
      "description": "A specific match within a tournament.",
      "type": "object",
      "properties": {
        "tournamentId": { "type": "string" },
        "teamA": { "$ref": "#/backend/entities/Team" },
        "teamB": { "$ref": "#/backend/entities/Team" },
        "scoreA": { "type": "number" },
        "scoreB": { "type": "number" },
        "status": { "type": "string", "enum": ["live", "scheduled", "finished"] },
        "startTime": { "type": "string", "format": "date-time" },
        "description": { "type": "string" },
        "votesA": { "type": "number" },
        "votesB": { "type": "number" }
      },
      "required": ["tournamentId", "teamA", "teamB", "status"]
    },
    "Team": {
      "title": "Team",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "logo": { "type": "string" }
      }
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended user data including rewards and device identification.",
      "type": "object",
      "properties": {
        "mobile": { "type": "string" },
        "deviceId": { "type": "string" },
        "coins": { "type": "number" },
        "withdrawableCoins": { "type": "number" },
        "referralCode": { "type": "string" },
        "referredBy": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "isBanned": { "type": "boolean" }
      }
    },
    "LedgerEntry": {
      "title": "Ledger Entry",
      "description": "A financial transaction for a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["deposit", "withdrawal", "income", "entry_fee"] },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] }
      }
    },
    "AppSettings": {
      "title": "App Settings",
      "type": "object",
      "properties": {
        "maintenanceMode": { "type": "boolean" },
        "coinValuePerDollar": { "type": "number" },
        "adminProfitPercentage": { "type": "number" },
        "videoWallEnabled": { "type": "boolean" },
        "offerWallEnabled": { "type": "boolean" },
        "cpaLeadEnabled": { "type": "boolean" },
        "cpaLeadUrl": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["phone", "password"]
  },
  "firestore": {
    "/tournaments/{tournamentId}": {
      "schema": "Tournament",
      "description": "Collection of all tournaments."
    },
    "/registrations/{regId}": {
      "schema": "Registration",
      "description": "Global tournament registrations."
    },
    "/support/{msgId}": {
      "schema": "SupportMessage",
      "description": "Support messages and AI chat logs."
    },
    "/matches/{matchId}": {
      "schema": "Match",
      "description": "Real-time match data across all tournaments."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account and reward details."
    },
    "/users/{userId}/ledger/{entryId}": {
      "schema": "LedgerEntry",
      "description": "Transaction history per user."
    },
    "/settings/global": {
      "schema": "AppSettings",
      "description": "Global application configuration."
    }
  }
}
