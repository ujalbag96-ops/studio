
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with academic focus and earnings.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "coins": { "type": "number" },
        "winningBalance": { "type": "number" },
        "taskBalance": { "type": "number" },
        "bonusBalance": { "type": "number" },
        "country": { "type": "string" },
        "rank": { "type": "string", "enum": ["Bronze", "Silver", "Gold", "Elite"] },
        "isSuspended": { "type": "boolean" },
        "vipLevel": { "type": "number" },
        "cpaTasksCount": { "type": "number" },
        "generalTasksCount": { "type": "number" },
        "totalReferrals": { "type": "number" }
      }
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Global system configuration nodes.",
      "type": "object",
      "properties": {
        "maintenanceMode": { "type": "boolean" },
        "reviewMode": { "type": "boolean" },
        "autoWithdrawalEnabled": { "type": "boolean" },
        "autoWithdrawalMaxAmount": { "type": "number" },
        "adminUpiId": { "type": "string" },
        "automaticGatewayEnabled": { "type": "boolean" }
      }
    },
    "PayoutRequest": {
      "title": "PayoutRequest",
      "description": "Financial withdrawal request record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "method": { "type": "string" },
        "destination": { "type": "string" },
        "processedBy": { "type": "string", "enum": ["manual", "automatic"] },
        "gatewayTransactionId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google", "phone"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account data"
    },
    "/app_settings/global_config": {
      "schema": "AppSettings",
      "description": "Master system configuration"
    },
    "/payouts/{payoutId}": {
      "schema": "PayoutRequest",
      "description": "Payout processing queue"
    }
  }
}
