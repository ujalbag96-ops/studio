
{
  "entities": {
    "Tournament": {
      "title": "Tournament",
      "description": "Details of a competitive gaming tournament.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "upcoming", "completed"] },
        "game": { "type": "string" },
        "prizePool": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "banner": { "type": "string" }
      },
      "required": ["name", "status", "game", "prizePool"]
    },
    "Match": {
      "title": "Match",
      "description": "A specific match within a tournament.",
      "type": "object",
      "properties": {
        "tournamentId": { "type": "string" },
        "teamA": { "$ref": "#/backend/entities/Team" },
        "teamB": { "$ref": "#/backend/entities/Team" },
        "scoreA": { "type": "number" },
        "scoreB": { "type": "number" },
        "status": { "type": "string", "enum": ["live", "scheduled", "finished"] },
        "startTime": { "type": "string", "format": "date-time" },
        "description": { "type": "string" },
        "votesA": { "type": "number" },
        "votesB": { "type": "number" }
      },
      "required": ["tournamentId", "teamA", "teamB", "status"]
    },
    "Team": {
      "title": "Team",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "logo": { "type": "string" }
      }
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended user data including rewards and device identification.",
      "type": "object",
      "properties": {
        "mobile": { "type": "string" },
        "deviceId": { "type": "string" },
        "coins": { "type": "number" },
        "referralCode": { "type": "string" },
        "referredBy": { "type": "string" },
        "isAdmin": { "type": "boolean" }
      }
    },
    "LedgerEntry": {
      "title": "Ledger Entry",
      "description": "A financial transaction for a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["deposit", "withdrawal", "income"] },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] }
      }
    },
    "AppSettings": {
      "title": "App Settings",
      "type": "object",
      "properties": {
        "maintenanceMode": { "type": "boolean" },
        "cpaLeadUrl": { "type": "string" },
        "cpaLeadApiKey": { "type": "string" },
        "cpaLeadPostbackUrl": { "type": "string" },
        "withdrawalGateways": { "type": "array", "items": { "type": "string" } },
        "videoAdProvider": { "type": "string", "enum": ["unity", "applovin"] },
        "videoAdPlacementId": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["phone", "password"]
  },
  "firestore": {
    "/tournaments/{tournamentId}": {
      "schema": "Tournament",
      "description": "Collection of all tournaments."
    },
    "/matches/{matchId}": {
      "schema": "Match",
      "description": "Real-time match data across all tournaments."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account and reward details."
    },
    "/users/{userId}/ledger/{entryId}": {
      "schema": "LedgerEntry",
      "description": "Transaction history per user."
    },
    "/settings/global": {
      "schema": "AppSettings",
      "description": "Global application configuration."
    }
  }
}
