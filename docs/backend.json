
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with triple-balance wallet and tracking parameters.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "depositBalance": { "type": "number" },
        "winningBalance": { "type": "number" },
        "bonusBalance": { "type": "number" },
        "taskBalance": { "type": "number" },
        "coins": { "type": "number" },
        "referralCode": { "type": "string" },
        "tasksCompletedCount": { "type": "number" },
        "isAccountActivated": { "type": "boolean" },
        "lastIp": { "type": "string" },
        "country": { "type": "string" },
        "lastSpinTimestamp": { "type": "string" }
      }
    },
    "JhilliConfig": {
      "title": "JhilliConfig",
      "description": "Spin wheel operational parameters.",
      "type": "object",
      "properties": {
        "rewards": { "type": "array", "items": { "type": "number" } },
        "dailyFreeLimit": { "type": "number" },
        "spinCost": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Master user profiles"
    },
    "/app_settings/jhilli_config": {
      "schema": "JhilliConfig",
      "description": "Dynamic spin wheel configuration"
    },
    "/app_settings/global_config": {
      "schema": "object",
      "description": "Global system configuration for Ads and APIs"
    }
  }
}
