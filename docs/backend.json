
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with MLM referral hierarchy and multi-tier balances.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "depositBalance": { "type": "number" },
        "winningBalance": { "type": "number" },
        "bonusBalance": { "type": "number" },
        "taskBalance": { "type": "number" },
        "referralCommissionBalance": { "type": "number" },
        "coins": { "type": "number" },
        "referralCode": { "type": "string" },
        "referredBy": { "type": "string" },
        "referredByL2": { "type": "string" },
        "mlmLevel": { "type": "number" },
        "tasksCompletedCount": { "type": "number" },
        "isAccountActivated": { "type": "boolean" },
        "lastIp": { "type": "string" },
        "country": { "type": "string" },
        "riskNoticeAccepted": { "type": "boolean" }
      }
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer support and account recovery ticket",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userContact": { "type": "string" },
        "subject": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "resolved", "closed"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "timestamp": { "type": "string" }
      }
    },
    "PaymentDispute": {
      "title": "PaymentDispute",
      "description": "UPI payment dispute with UTR and receipt proof",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "utrId": { "type": "string" },
        "amount": { "type": "number" },
        "receiptDataUri": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "timestamp": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Master user profiles"
    },
    "/support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Human support tickets"
    },
    "/payment_disputes/{disputeId}": {
      "schema": "PaymentDispute",
      "description": "UPI payment disputes and UTR audits"
    },
    "/app_settings/global_config": {
      "schema": "object",
      "description": "Global system settings"
    }
  }
}
