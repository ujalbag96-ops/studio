
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with academic focus and earnings.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "coins": { "type": "number" },
        "department": { "type": "string" },
        "semester": { "type": "number" },
        "riskNoticeAccepted": { "type": "boolean" },
        "preferredLanguage": { "type": "string", "enum": ["en", "or"] }
      }
    },
    "StudyMaterial": {
      "title": "StudyMaterial",
      "description": "Educational resources for students",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["Notes", "PYQ", "Syllabus"] },
        "url": { "type": "string" },
        "isPremium": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google", "phone"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account data"
    },
    "/departments/{deptId}/subjects/{subjectId}/materials/{materialId}": {
      "schema": "StudyMaterial",
      "description": "Nested hierarchy for academic resources"
    },
    "/study_materials/{materialId}": {
      "schema": "StudyMaterial",
      "description": "Flat index for global material search"
    }
  }
}
