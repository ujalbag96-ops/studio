
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with MLM referral hierarchy and multi-tier balances.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "depositBalance": { "type": "number" },
        "winningBalance": { "type": "number" },
        "bonusBalance": { "type": "number" },
        "taskBalance": { "type": "number" },
        "referralCommissionBalance": { "type": "number" },
        "coins": { "type": "number" },
        "walletBalanceINR": { "type": "number" },
        "referralCode": { "type": "string" },
        "referredBy": { "type": "string" },
        "referredByL2": { "type": "string" },
        "mlmLevel": { "type": "number" },
        "tasksCompletedCount": { "type": "number" },
        "isAccountActivated": { "type": "boolean" },
        "lastIp": { "type": "string" },
        "country": { "type": "string" },
        "riskNoticeAccepted": { "type": "boolean" }
      }
    },
    "Movie": {
      "title": "Movie",
      "description": "Premium cinematic content for streaming",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "poster": { "type": "string" },
        "videoUrl": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "LotteryEntry": {
      "title": "LotteryEntry",
      "description": "Daily lottery participant entry",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "selectedNumber": { "type": "number" },
        "timestamp": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google", "phone"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Master user profiles"
    },
    "/movies/{movieId}": {
      "schema": "Movie",
      "description": "Streaming movie library"
    },
    "/lottery_entries/{entryId}": {
      "schema": "LotteryEntry",
      "description": "Active daily lottery entries"
    },
    "/lottery_results/{resultId}": {
      "schema": "object",
      "description": "Draw history and winner logs"
    },
    "/daily_pool/config": {
      "schema": "object",
      "description": "Real-time pool participant tracker"
    }
  }
}
