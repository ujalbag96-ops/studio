{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with balance and admin status.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "coins": { "type": "number" },
        "withdrawableCoins": { "type": "number" },
        "isAdmin": { "type": "boolean" },
        "isBanned": { "type": "boolean" },
        "deviceId": { "type": "string" }
      }
    },
    "Tournament": {
      "title": "Tournament",
      "description": "Gaming tournament details.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "upcoming", "completed"] },
        "entryFee": { "type": "number" },
        "prizePool": { "type": "string" }
      }
    },
    "Match": {
      "title": "Match",
      "description": "Individual battle details.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "status": { "type": "string", "enum": ["live", "scheduled", "finished"] },
        "scoreA": { "type": "number" },
        "scoreB": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["password", "phone", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User documents"
    },
    "/tournaments/{tournamentId}": {
      "schema": "Tournament",
      "description": "Tournament records"
    },
    "/matches/{matchId}": {
      "schema": "Match",
      "description": "Match records"
    },
    "/settings/global": {
      "schema": "object",
      "description": "App settings"
    }
  }
}