
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with triple-balance wallet and tracking parameters.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "depositBalance": { "type": "number" },
        "winningBalance": { "type": "number" },
        "bonusBalance": { "type": "number" },
        "taskBalance": { "type": "number" },
        "coins": { "type": "number" },
        "referralCode": { "type": "string" },
        "tasksCompletedCount": { "type": "number" },
        "isAccountActivated": { "type": "boolean" },
        "lastIp": { "type": "string" },
        "country": { "type": "string" },
        "rank": { "type": "string", "enum": ["Bronze", "Silver", "Gold", "Elite"] }
      }
    },
    "CPATask": {
      "title": "CPATask",
      "description": "CPA mission details for users.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "appName": { "type": "string" },
        "link": { "type": "string" },
        "reward": { "type": "number" },
        "category": { "type": "string" }
      }
    },
    "WithdrawalRequest": {
      "title": "WithdrawalRequest",
      "description": "User withdrawal applications.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "amount": { "type": "number" },
        "method": { "type": "string" },
        "destination": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "timestamp": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Master user profiles"
    },
    "/users/{userId}/ledger/{id}": {
      "schema": "object",
      "description": "Financial transaction history"
    },
    "/withdrawals/{id}": {
      "schema": "WithdrawalRequest",
      "description": "Global payout queue"
    },
    "/cpa_tasks/{id}": {
      "schema": "CPATask",
      "description": "Active missions for users"
    },
    "/cricket_matches/{id}": {
      "schema": "object",
      "description": "Live cricket signal data"
    },
    "/polls/{id}": {
      "schema": "object",
      "description": "Prediction polls"
    },
    "/settings/global": {
      "schema": "object",
      "description": "Global system configuration"
    }
  }
}
