
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Master user identity with 10-node yield tracking and revenue share allocation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "coins": { "type": "number" },
        "winningBalance": { "type": "number" },
        "taskBalance": { "type": "number" },
        "bonusBalance": { "type": "number" },
        "depositBalance": { "type": "number" },
        "walletBalanceINR": { "type": "number" },
        "pendingRevenueShare": { "type": "number" },
        "country": { "type": "string" },
        "geo_region": { "type": "string" },
        "rank": { "type": "string", "enum": ["Bronze", "Silver", "Gold", "Elite"] },
        "vipLevel": { "type": "number" },
        "isSuspended": { "type": "boolean" },
        "riskNoticeAccepted": { "type": "boolean" },
        "totalReferrals": { "type": "number" },
        "cpaTasksCount": { "type": "number" },
        "generalTasksCount": { "type": "number" },
        "scholarPoints": { "type": "number" },
        "referralCode": { "type": "string" },
        "preferredLanguage": { "type": "string" }
      }
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Master system config for 50+ dynamic modules visibility control.",
      "type": "object",
      "properties": {
        "maintenanceMode": { "type": "boolean" },
        "reviewMode": { "type": "boolean" },
        "autoWithdrawalEnabled": { "type": "boolean" },
        "razorpayAutoPayout": { "type": "boolean" },
        "userRevenueSharePercent": { "type": "number", "default": 30 },
        "node_scholar_dividend": { "type": "boolean" },
        "node_tutor_visible": { "type": "boolean" },
        "node_global_cpa": { "type": "boolean" },
        "node_quiz_arena": { "type": "boolean" },
        "node_daily_streak_visible": { "type": "boolean" },
        "node_referral_engine": { "type": "boolean" },
        "node_book_download": { "type": "boolean" },
        "node_mock_tests": { "type": "boolean" },
        "node_live_classroom": { "type": "boolean" },
        "node_handwritten_notes": { "type": "boolean" },
        "node_resume_builder": { "type": "boolean" },
        "node_typing_master": { "type": "boolean" },
        "node_spin_wheel": { "type": "boolean" },
        "node_scratch_cards": { "type": "boolean" },
        "node_pomodoro": { "type": "boolean" },
        "node_gpa_calc": { "type": "boolean" },
        "node_push_center": { "type": "boolean" },
        "node_support_desk": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google", "phone"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Global user identity and asset ledger"
    },
    "/app_settings/global_config": {
      "schema": "AppSettings",
      "description": "Industrial control node with 50+ module master switches"
    }
  }
}
