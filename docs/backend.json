
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with academic focus, earnings, and security status.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "coins": { "type": "number" },
        "winningBalance": { "type": "number" },
        "taskBalance": { "type": "number" },
        "bonusBalance": { "type": "number" },
        "walletBalanceINR": { "type": "number" },
        "country": { "type": "string" },
        "rank": { "type": "string", "enum": ["Bronze", "Silver", "Gold", "Elite"] },
        "vipLevel": { "type": "number" },
        "isSuspended": { "type": "boolean" },
        "cpaTasksCount": { "type": "number" },
        "generalTasksCount": { "type": "number" },
        "totalReferrals": { "type": "number" },
        "scholarPoints": { "type": "number" },
        "referralCode": { "type": "string" },
        "referredBy": { "type": "string" },
        "quizLives": { "type": "number" }
      }
    },
    "QuizLeaderboard": {
      "title": "QuizLeaderboard",
      "description": "Real-time ranking for weekly academic competition.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "score": { "type": "number" },
        "rank": { "type": "number" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      }
    },
    "GlobalQuizPool": {
      "title": "GlobalQuizPool",
      "description": "Dynamic prize pool calculated from ad revenue.",
      "type": "object",
      "properties": {
        "currentPrizeINR": { "type": "number" },
        "totalParticipants": { "type": "number" },
        "nextDrawTime": { "type": "string" }
      }
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Master system configuration for 10-node multi-revenue architecture.",
      "type": "object",
      "properties": {
        "maintenanceMode": { "type": "boolean" },
        "reviewMode": { "type": "boolean" },
        "autoWithdrawalEnabled": { "type": "boolean" },
        "adminUpiId": { "type": "string" },
        "node_scholar_dividend": { "type": "boolean" },
        "node_quiz_arena": { "type": "boolean" },
        "node_global_cpa": { "type": "boolean" },
        "node_micro_tasks: ": { "type": "boolean" },
        "node_surveys": { "type": "boolean" },
        "node_ad_stream": { "type": "boolean" },
        "node_content_analysis": { "type": "boolean" },
        "node_referral_engine": { "type": "boolean" },
        "node_arcade_rewards": { "type": "boolean" },
        "node_daily_checkin": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google", "phone"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Global user identity and asset ledger"
    },
    "/app_settings/global_config": {
      "schema": "AppSettings",
      "description": "Industrial control node for 10 revenue streams"
    },
    "/quiz_leaderboard/{userId}": {
      "schema": "QuizLeaderboard",
      "description": "Real-time weekly scholar rankings"
    },
    "/quiz_pool/current": {
      "schema": "GlobalQuizPool",
      "description": "Live prize pool linked to ad signals"
    }
  }
}
