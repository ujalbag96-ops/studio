
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with MLM referral hierarchy and multi-tier balances.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "depositBalance": { "type": "number" },
        "winningBalance": { "type": "number" },
        "bonusBalance": { "type": "number" },
        "taskBalance": { "type": "number" },
        "referralCommissionBalance": { "type": "number" },
        "coins": { "type": "number" },
        "referralCode": { "type": "string" },
        "referredBy": { "type": "string", "description": "L1 Upline UID" },
        "referredByL2": { "type": "string", "description": "L2 Upline UID" },
        "mlmLevel": { "type": "number", "enum": [0, 1000, 3000, 5000, 10000] },
        "tasksCompletedCount": { "type": "number" },
        "isAccountActivated": { "type": "boolean" },
        "lastIp": { "type": "string" },
        "country": { "type": "string" },
        "lastSpinTimestamp": { "type": "string" }
      }
    },
    "MlmPackage": {
      "title": "MlmPackage",
      "description": "MLM Tiered joining packages",
      "type": "object",
      "properties": {
        "tierName": { "type": "string" },
        "cost": { "type": "number" },
        "l1CommissionPercent": { "type": "number" },
        "l2CommissionPercent": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Master user profiles with MLM links"
    },
    "/app_settings/mlm_config": {
      "schema": "object",
      "description": "MLM commission rates and tier settings"
    }
  }
}
