rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public read for events and metadata to maintain frontend transparency
    match /{document=**} {
      allow read: if true;
    }

    // Executive Administrative Identity
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "ujalbag96@gmail.com";
    }

    // Strict User Profile Compliance
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Compliance Gate: Users cannot increase their own balance fields. 
      // They can only decrement for participation or be updated by Admin.
      allow update: if isAdmin() || (
        request.auth != null && request.auth.uid == userId &&
        request.resource.data.coins <= resource.data.coins &&
        request.resource.data.winningBalance <= resource.data.winningBalance &&
        request.resource.data.depositBalance <= resource.data.depositBalance &&
        request.resource.data.isAdmin == resource.data.isAdmin
      );
      
      match /ledger/{entryId} {
        allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      }
    }

    // Global infrastructure settings
    match /settings/{docId} {
      allow write: if isAdmin();
    }

    // Operational Event management
    match /tournaments/{tournamentId} {
      allow write: if isAdmin();
    }

    match /matches/{matchId} {
      allow write: if isAdmin();
    }

    // Registration compliance
    match /registrations/{regId} {
      allow create: if request.auth != null;
      allow delete, update: if isAdmin();
    }

    // Communication feed protocols
    match /support/{msgId} {
      allow write: if request.auth != null;
    }
    
    match /notifications/{notifId} {
      allow write: if isAdmin();
    }
    
    // Collection group audit allow for executive review
    match /{path=**}/ledger/{ledgerId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.userId);
    }
  }
}