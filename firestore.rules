
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && request.auth.token.email.lower() == "ujalbag96@gmail.com";
    }

    match /app_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cpa_missions/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // CRITICAL: User CANNOT increase their own balance fields.
      // They can only update non-financial fields or DECREASE their balance (spend).
      allow update: if isAdmin() || (
        request.auth != null && request.auth.uid == userId &&
        request.resource.data.coins <= resource.data.coins &&
        request.resource.data.winningBalance <= resource.data.winningBalance &&
        request.resource.data.depositBalance <= resource.data.depositBalance &&
        request.resource.data.taskBalance <= resource.data.taskBalance
      );
      
      match /ledger/{entryId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if isAdmin(); // Only system/admin can write to ledger to prevent fake entry logs
      }
    }

    match /payouts/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    match /payment_disputes/{disputeId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow update: if isAdmin();
    }
    
    match /fraud_alerts/{alertId} {
      allow create: if false; // Only server-side can log fraud
      allow read: if isAdmin();
    }

    match /{document=**} {
      allow read: if true;
    }
  }
}
