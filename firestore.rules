
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Executive Administrative Identity
    function isAdmin() {
      return request.auth != null && request.auth.token.email.lower() == "ujalbag96@gmail.com";
    }

    // Public Infrastructure (CRITICAL FIX: Ensure global configs are readable by everyone for maintenance gate)
    match /app_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public Operational Data
    match /cpa_missions/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cricket_matches/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /esports_matches/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /esports_polls/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /polls/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Secure Transactional Data
    match /payouts/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    match /registrations/{regId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow delete, update: if isAdmin();
    }

    match /support/{msgId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Strict User Profile Compliance
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Compliance Gate: Users cannot increase their own balance fields. 
      allow update: if isAdmin() || (
        request.auth != null && request.auth.uid == userId &&
        request.resource.data.coins <= resource.data.coins &&
        request.resource.data.winningBalance <= resource.data.winningBalance &&
        request.resource.data.depositBalance <= resource.data.depositBalance
      );
      
      match /ledger/{entryId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      }
    }
    
    // Global fallback for any legacy or missed public reads
    match /{document=**} {
      allow read: if true;
    }
  }
}
