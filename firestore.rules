rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Sabhi users ke liye read access allow (Home page ke liye)
    match /{document=**} {
      allow read: if true;
    }

    // Admin (ujalbag96@gmail.com) ke liye full write access
    // Aur normal users ke liye unka apna data create/update allow
    match /users/{userId} {
      allow write: if request.auth != null && (request.auth.token.email == "ujalbag96@gmail.com" || request.auth.uid == userId);
      
      match /ledger/{entryId} {
        allow write: if request.auth != null && (request.auth.token.email == "ujalbag96@gmail.com" || request.auth.uid == userId);
      }
    }

    match /tournaments/{tournamentId} {
      allow write: if request.auth != null && request.auth.token.email == "ujalbag96@gmail.com";
    }

    match /matches/{matchId} {
      allow write: if request.auth != null && request.auth.token.email == "ujalbag96@gmail.com";
    }

    match /registrations/{regId} {
      allow write: if request.auth != null;
    }

    match /support/{msgId} {
      allow write: if request.auth != null;
    }

    match /settings/{docId} {
      allow write: if request.auth != null && request.auth.token.email == "ujalbag96@gmail.com";
    }
  }
}
